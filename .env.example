# Copy to .env and fill in values for local import testing
SYNCUP_IMPORT_URL=http://localhost:6001/api/job-service/job/external/import
SYNCUP_IMPORT_API_KEY=local-dev-import-key
SKIP_LOCAL_PUSH=true
HEADLESS=true

# Optional — LinkedIn often requires login; copy li_at from browser DevTools → Application → Cookies
# LINKEDIN_LI_AT=
# LINKEDIN_JSESSIONID=
